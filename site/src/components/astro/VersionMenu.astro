---
import { packageVersion, packages } from '~/data/versions'
---

<div class="version-menu xyz-appear xyz-paused-all" data-xyz="fade small-3 ease-out-back delay-2" data-version-menu>
  <button
    class="version-menu__trigger"
    type="button"
    aria-expanded="false"
    aria-controls="version-menu-packages"
    aria-label={`AnimXYZ v${packageVersion}, show package versions`}
  >
    v{packageVersion}
  </button>
  <ul class="version-menu__card" id="version-menu-packages">
    {
      packages.map((pkg, index) => (
        <li style={`--item-index: ${index}`}>
          <a class="version-menu__link" href={pkg.url} target="_blank" rel="noopener noreferrer">
            <span class="version-menu__name">{pkg.name}</span>
            <span class="version-menu__version">{pkg.version}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  // Hover and keyboard focus open the card in CSS; clicks toggle it so it
  // also works on touch screens.
  const menu = document.querySelector<HTMLElement>('[data-version-menu]')
  const trigger = menu?.querySelector<HTMLButtonElement>('.version-menu__trigger')

  function setOpen(open: boolean) {
    menu!.classList.toggle('open', open)
    if (open) menu!.classList.remove('suppressed')
    trigger!.setAttribute('aria-expanded', String(open))
  }

  if (menu && trigger) {
    trigger.addEventListener('click', () => setOpen(!menu.classList.contains('open')))
    menu.addEventListener('mouseleave', () => {
      setOpen(false)
      menu.classList.remove('suppressed')
    })
    menu.addEventListener('focusout', (event) => {
      if (!menu.contains(event.relatedTarget as Node)) menu.classList.remove('suppressed')
    })
    document.addEventListener('click', (event) => {
      if (!menu.contains(event.target as Node)) setOpen(false)
    })
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setOpen(false)
        menu.classList.add('suppressed')
        trigger.focus()
      }
    })
  }
</script>

<style lang="scss">
  .version-menu {
    --menu-bg: #{primary-color(100)};
    --menu-duration: 0.15s;
    position: absolute;
    top: $sp-m;
    left: $sp-m;
    z-index: 5;

    @include dark-mode {
      --menu-bg: #{primary-color(800)};
    }

    @media (width < $bp-phone) {
      top: $sp-s;
      left: $sp-s;
    }

    @media (prefers-reduced-motion: reduce) {
      --menu-duration: 0s;
    }
  }

  .version-menu__trigger {
    position: relative;
    display: flex;
    align-items: center;
    height: 2.25rem;
    padding: 0 $sp-xs;
    border-radius: $br-l;
    font-family: $font-stack-mono;
    font-size: $fs-m;
    font-weight: bold;
    color: primary-color(700);
    transition: var(--menu-duration) $ease-in-out;
    transition-property: color, background-color, border-radius, box-shadow;

    @include dark-mode {
      color: primary-color(200);
    }

    &:focus {
      outline: none;
    }

    &:focus-visible {
      box-shadow: 0 0 0 4px primary-color(200, 0.5);
    }

    // Inverted corner joining the tab to the top edge of the wider card.
    &::after {
      content: '';
      position: absolute;
      bottom: 0;
      right: -$br-l;
      width: $br-l;
      height: $br-l;
      background: radial-gradient(circle at 100% 0, transparent $br-l, var(--menu-bg) calc(#{$br-l} + 0.5px));
      opacity: 0;
      transition: opacity var(--menu-duration) $ease-in-out;
    }
  }

  .version-menu__card {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 100%;
    margin: 0;
    padding: $sp-xxxs $sp-xxs $sp-xxs;
    list-style: none;
    background-color: var(--menu-bg);
    border-radius: 0 $br-l $br-l $br-l;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity var(--menu-duration) $ease-in-out,
      visibility 0s linear var(--menu-duration);

    li {
      opacity: 0;
      transform: translateY(-0.125rem);
      transition: var(--menu-duration) $ease-out;
      transition-property: opacity, transform;
    }
  }

  .version-menu__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: $sp-l;
    padding: $sp-xxs $sp-xs;
    border-radius: $br-m;
    font-family: $font-stack-mono;
    font-size: $fs-s;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 0.2s $ease-in-out;

    &:hover,
    &:focus-visible {
      outline: none;
      background-color: primary-color(500, 0.15);

      .version-menu__name {
        color: primary-color(950);

        @include dark-mode {
          color: primary-color(50);
        }
      }
    }
  }

  .version-menu__name {
    font-weight: bold;
    color: primary-color(800);
    transition: color 0.2s $ease-in-out;

    @include dark-mode {
      color: primary-color(100);
    }
  }

  .version-menu__version {
    color: primary-color(600);

    @include dark-mode {
      color: primary-color(300);
    }
  }

  // Open: hover (on devices that can hover), keyboard focus, or a click/tap.
  @mixin open {
    .version-menu__trigger {
      color: primary-color(900);
      background-color: var(--menu-bg);
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;

      &::after {
        opacity: 1;
      }

      @include dark-mode {
        color: primary-color(50);
      }
    }

    .version-menu__card {
      visibility: visible;
      opacity: 1;
      transition:
        opacity var(--menu-duration) $ease-in-out,
        visibility 0s;

      li {
        opacity: 1;
        transform: none;
        transition-delay: calc(var(--item-index) * 0.025s);
      }
    }
  }

  // `.suppressed` keeps it closed after Escape until the pointer or focus leaves.
  @media (hover: hover) {
    .version-menu:not(.suppressed):hover {
      @include open;
    }
  }

  .version-menu:not(.suppressed):has(:focus-visible),
  .version-menu.open {
    @include open;
  }
</style>
